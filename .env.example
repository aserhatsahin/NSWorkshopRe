# Uygulamanın kullandığı veritabanı adresi. Neon'da "pooled" (havuzlu) adres.
DATABASE_URL=""
# Yalnızca migration'lar için havuzsuz adres. Neon'da "direct" adres.
# Yerelde boş bırak; DATABASE_URL kullanılır.
DIRECT_URL=""
# Yalnızca `prisma migrate dev` için; yerelde `npx prisma dev` kullanılıyorsa gerekir.
SHADOW_DATABASE_URL=""

# Oturum çerezlerini imzalar. Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Canlıda ilk atölye sahibi hesabını /setup sayfasından oluşturmak için.
# Kurulumdan sonra silinebilir. Üretmek için: openssl rand -base64 24
SETUP_TOKEN=""

# Yerelde `npm run db:seed` ile oluşturulacak OWNER hesabı
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME=""
# "true" ise seed örnek grup ve ürün de ekler (yalnızca yerel geliştirme).
SEED_SAMPLE_DATA=""
